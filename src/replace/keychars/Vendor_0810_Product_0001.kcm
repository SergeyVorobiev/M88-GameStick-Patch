type FULL

key BUTTON_A {
    base:                               fallback DPAD_CENTER
}

key BUTTON_B {
    base:                               fallback BACK
}

key BUTTON_X {
    base:                               fallback SEARCH
}

key BUTTON_Y {
    base:                               fallback SPACE
}

key BUTTON_THUMBL {
    base:                               fallback CTRL_LEFT
}

key BUTTON_THUMBR {
    base:                               fallback SHIFT_LEFT
}

key BUTTON_SELECT {
    base:                               fallback MENU
}

key BUTTON_START {
    base:                               fallback ENTER
}

key BUTTON_L1 {
    base:                               fallback PAGE_UP
}

key BUTTON_L2 {
    base:                               fallback PAGE_DOWN
}

key BUTTON_R1 {
    base:                               fallback TAB
}

key BUTTON_R2 {
    label:                              'T'
    base:                               't'
    shift, capslock:                    'T'

}
