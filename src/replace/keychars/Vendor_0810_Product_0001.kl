# Twin USB Joystick 0810 (2064) / 0001 (1)

key 0x120   BUTTON_Y # 288
key 0x121   BUTTON_B # 289
key 0x122   BUTTON_A # 290
key 0x123   BUTTON_X # 291
key 0x124   BUTTON_L1 # 292
key 0x125   BUTTON_R1 # 293
key 0x126   BUTTON_L2 # 294
key 0x127   BUTTON_R2 # 295
key 0x128   BUTTON_SELECT # 296
key 0x129   BUTTON_START # 297
key 0x12a   BUTTON_THUMBL # 298
key 0x12b   BUTTON_THUMBR # 299

# scale = multiplier, flat = dead zone, fuzz = noise suppression
# axis 0x00 X scale 1.5 flat 0.05 fuzz 0.01

# L3 Analog
axis 0x00 X
axis 0x01 Y

# R3 Analog
axis 0x02 Z
axis 0x05 RZ

# D-pad
axis 0x10 HAT_X
axis 0x11 HAT_Y